<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SA Labour Law & Contract Compliance Assistant" />
    <title>@ViewData["Title"] — SA Labour Law</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="nav">
        <a class="nav-brand" href="/">
            SA <span>Labour Law</span>
        </a>
        <ul class="nav-links">
            <li><a href="/Ask" class="@(Context.Request.Path.StartsWithSegments("/Ask") ? "active" : "")">Legislation Q&A</a></li>
            <li><a href="/Contracts/Upload" class="@(Context.Request.Path.StartsWithSegments("/Contracts") ? "active" : "")">Contract Review</a></li>
        </ul>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>SA Labour Law &amp; Contract Compliance Assistant &mdash; For informational purposes only. Not legal advice.</p>
        <p class="mt-sm"><a href="https://www.labour.gov.za" target="_blank" rel="noopener">Department of Employment and Labour</a></p>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>